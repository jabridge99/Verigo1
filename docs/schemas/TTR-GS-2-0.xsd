<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://austrac.gov.au/schema/reporting/TTR-GS-2-0"
           xmlns:xlink="http://www.w3.org/1999/xlink"
           xmlns:d="http://docbook.org/ns/docbook"
           targetNamespace="http://austrac.gov.au/schema/reporting/TTR-GS-2-0"
           elementFormDefault="qualified"
           xml:lang="en">
<!--Reports made using this XML schema are pursuant to the requirements of section 43 of the AML/CTF Act. Criminal penalties may apply for providing false or misleading information and civil penalties may apply for failing to supply information.-->
   <xs:annotation>
      <xs:documentation source="titlePage">
         <d:title>Electronic report file format specification –
        threshold transaction report (gambling services)</d:title>
         <d:author>
            <d:orgname>Australian Transaction Reports and Analysis Centre (AUSTRAC)</d:orgname>
            <d:uri>http://www.austrac.gov.au/</d:uri>
         </d:author>
         <d:revhistory>
            <d:revision>
               <d:revnumber>2.0d</d:revnumber>
               <d:date>April 2025</d:date>
            </d:revision>
         </d:revhistory>
         <d:copyright>
            <d:year>2010</d:year>
            <d:holder>Commonwealth of Australia</d:holder>
         </d:copyright>
         <d:keywordset>
            <d:keyword>AUSTRAC</d:keyword>
            <d:keyword>TTR-GS</d:keyword>
            <d:keyword>Threshold transaction report, gambling services</d:keyword>
            <d:keyword>Report file format</d:keyword>
            <d:keyword>User guide</d:keyword>
            <d:keyword>Schema reference</d:keyword>
            <d:keyword>XSD reference</d:keyword>
         </d:keywordset>
      </xs:documentation>
   </xs:annotation>
   <xs:element name="ttr-gsList">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="reNumber" type="RENumber"/>
            <xs:element name="fileName" type="TTRGSFileName"/>
            <xs:element name="reportCount" type="ReportCount"/>
            <xs:element ref="ttr-gs" maxOccurs="unbounded"/>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="ttr-gs">
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="header"/>
            <xs:element ref="customer" maxOccurs="unbounded"/>
            <xs:choice>
               <xs:sequence>
                  <xs:element ref="representedOrganisation" minOccurs="0" maxOccurs="unbounded"/>
                  <xs:element ref="individualConductingTxn" maxOccurs="unbounded"/>
               </xs:sequence>
               <xs:element ref="methodOfConductingTxn"/>
            </xs:choice>
            <xs:element ref="recipient" maxOccurs="unbounded"/>
            <xs:element ref="transaction"/>
         </xs:sequence>
         <xs:attributeGroup ref="RequiredAttrs"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="header">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="txnRefNo" type="TRN" minOccurs="0"/>
            <xs:element name="interceptFlag" type="xs:token" fixed="Y" minOccurs="0"/>
            <xs:element name="reportingBranch" type="Branch"/>
         </xs:sequence>
         <xs:attributeGroup ref="RequiredAttrs"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="customer">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="fullName" type="Name"/>
            <xs:element name="altName" type="Name" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="mainAddress" type="Address"/>
            <xs:element name="postalAddress" type="Address" minOccurs="0"/>
            <xs:element name="phone" type="PhoneNum" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="indOcc" type="IndustryOccupation" minOccurs="0"/>
            <xs:element name="abn" type="ABN" minOccurs="0"/>
            <xs:element name="acn" type="ACN" minOccurs="0"/>
            <xs:element name="arbn" type="ARBN" minOccurs="0"/>
            <xs:element name="businessStruct" type="BusinessStructure" minOccurs="0"/>
            <xs:element name="dob" type="DateOfBirth" minOccurs="0"/>
            <xs:element name="account" type="AccountNoBSB" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="identification" type="Identification" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="electDataSrc" type="ElectronicDataSource" minOccurs="0"
                        maxOccurs="unbounded"/>
         </xs:sequence>
         <xs:attributeGroup ref="RequiredAttrs"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="representedOrganisation">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="fullName" type="Name" minOccurs="0"/>
            <xs:element name="mainAddress" type="Address" minOccurs="0"/>
            <xs:element name="abn" type="ABN" minOccurs="0"/>
            <xs:element name="acn" type="ACN" minOccurs="0"/>
            <xs:element name="arbn" type="ARBN" minOccurs="0"/>
         </xs:sequence>
         <xs:attributeGroup ref="RequiredAttrs"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="individualConductingTxn">
      <xs:complexType>
         <xs:choice>
            <xs:element name="sameAsCustomer" type="PartyReference"/>
            <xs:sequence>
               <xs:choice>
                  <xs:element name="employeeOfCustomer" type="PartyReference"/>
                  <xs:element name="representsOrganisation" type="PartyReference" minOccurs="0"/>
               </xs:choice>
               <xs:element name="fullName" type="Name"/>
               <xs:element name="altName" type="Name" minOccurs="0" maxOccurs="unbounded"/>
               <xs:element name="mainAddress" type="Address" minOccurs="0"/>
               <xs:element name="postalAddress" type="Address" minOccurs="0"/>
               <xs:element name="phone" type="PhoneNum" minOccurs="0" maxOccurs="unbounded"/>
               <xs:element name="indOcc" type="IndustryOccupation" minOccurs="0"/>
               <xs:element name="dob" type="DateOfBirth" minOccurs="0"/>
               <xs:element name="identification" type="Identification" minOccurs="0" maxOccurs="unbounded"/>
               <xs:element name="electDataSrc" type="ElectronicDataSource" minOccurs="0"
                           maxOccurs="unbounded"/>
               <xs:element name="agencyAuthorisation" type="Authorisation" minOccurs="0"
                           maxOccurs="unbounded"/>
            </xs:sequence>
         </xs:choice>
         <xs:attributeGroup ref="RequiredAttrs"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="methodOfConductingTxn">
      <xs:complexType>
         <xs:choice>
            <xs:element name="method" type="TransactionMethod"/>
            <xs:element name="otherMethod" type="xs:token"/>
         </xs:choice>
         <xs:attributeGroup ref="RequiredAttrs"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="recipient">
      <xs:complexType>
         <xs:choice>
            <xs:element name="sameAsCustomer" type="PartyReference"/>
            <xs:sequence>
               <xs:element name="sameAsRepresentedOrganisation" type="PartyReference"/>
               <xs:element name="account" type="AccountNoBSB" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:sequence>
               <xs:element name="sameAsIndividualConductingTxn" type="PartyReference"/>
               <xs:element name="account" type="AccountNoBSB" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:sequence>
               <xs:element name="fullName" type="Name"/>
               <xs:element name="mainAddress" type="Address" minOccurs="0"/>
               <xs:element name="account" type="AccountNoBSB" minOccurs="0" maxOccurs="unbounded"/>
               <xs:element name="dob" type="DateOfBirth" minOccurs="0"/>
            </xs:sequence>
         </xs:choice>
         <xs:attributeGroup ref="RequiredAttrs"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="transaction">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="txnDate" type="AUSTRACDate"/>
            <xs:element name="totalAmount" type="AudAmount"/>
            <xs:element name="designatedSvc" type="DesignatedSvc"/>
            <xs:choice>
               <xs:element ref="moneyReceived"/>
               <xs:element ref="moneyProvided"/>
            </xs:choice>
         </xs:sequence>
         <xs:attributeGroup ref="RequiredAttrs"/>
      </xs:complexType>
   </xs:element>
   <xs:simpleType name="DesignatedSvc">
      <xs:restriction base="xs:token">
         <xs:enumeration value="BET_ACC"/>
         <xs:enumeration value="GAMCHSKL"/>
         <xs:enumeration value="GAM_BETT"/>
         <xs:enumeration value="GAM_EXCH"/>
         <xs:enumeration value="GAM_MACH"/>
         <xs:enumeration value="VALCARDS"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:element name="transactionMoneyReceived">
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="moneyReceived"/>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="transactionMoneyProvided">
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="moneyProvided"/>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="cash">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="ausCash" type="AudAmount" minOccurs="0"/>
            <xs:element name="foreignCash" type="CurrencyAmount" minOccurs="0" maxOccurs="unbounded"/>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="cashContra">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="ausCash" type="AudAmount" minOccurs="0"/>
            <xs:element name="foreignCash" type="CurrencyAmount" minOccurs="0" maxOccurs="unbounded"/>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="moneyReceived">
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="cash" minOccurs="0"/>
            <xs:element ref="nonCashReceived" minOccurs="0"/>
            <xs:element ref="cashContra" minOccurs="0"/>
            <xs:element ref="nonCashContraProvided" minOccurs="0"/>
         </xs:sequence>
         <xs:attributeGroup ref="RequiredAttrs"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="nonCashReceived">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="fai" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="gci" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="egi" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="oci" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="cri" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="wti" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="tci" type="NonCashAmountChequeOptional" minOccurs="0"
                        maxOccurs="unbounded"/>
            <xs:element name="chi" type="NonCashAmountChequeOptional" minOccurs="0"
                        maxOccurs="unbounded"/>
            <xs:element name="bci" type="NonCashAmountChequeOptional" minOccurs="0"
                        maxOccurs="unbounded"/>
            <xs:element name="bdi" type="NonCashAmountChequeOptional" minOccurs="0"
                        maxOccurs="unbounded"/>
            <xs:element name="svi" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="oti" type="NonCashAmountOther" minOccurs="0" maxOccurs="unbounded"/>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="nonCashContraProvided">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="fao" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="ito" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="gco" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="bio" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="bpo" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="mro" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="cho" type="NonCashAmountCheque" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="sio" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="sto" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="oto" type="NonCashAmountOther" minOccurs="0" maxOccurs="unbounded"/>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="moneyProvided">
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="cash" minOccurs="0"/>
            <xs:element ref="nonCashProvided" minOccurs="0"/>
            <xs:element ref="nonCashContraReceived" minOccurs="0"/>
         </xs:sequence>
         <xs:attributeGroup ref="RequiredAttrs"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="nonCashProvided">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="fao" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="ito" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="gco" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="bio" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="bpo" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="cho" type="NonCashAmountCheque" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="sio" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="sto" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="oto" type="NonCashAmountOther" minOccurs="0" maxOccurs="unbounded"/>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="nonCashContraReceived">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="fai" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="gci" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="egi" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="oci" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="cri" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="wti" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="tci" type="NonCashAmountChequeOptional" minOccurs="0"
                        maxOccurs="unbounded"/>
            <xs:element name="chi" type="NonCashAmountChequeOptional" minOccurs="0"
                        maxOccurs="unbounded"/>
            <xs:element name="bci" type="NonCashAmountChequeOptional" minOccurs="0"
                        maxOccurs="unbounded"/>
            <xs:element name="bdi" type="NonCashAmountChequeOptional" minOccurs="0"
                        maxOccurs="unbounded"/>
            <xs:element name="svi" type="NonCashAmount" minOccurs="0"/>
            <xs:element name="oti" type="NonCashAmountOther" minOccurs="0" maxOccurs="unbounded"/>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:attributeGroup name="RequiredAttrs">
      <xs:attribute name="id" type="xs:ID" use="required"/>
   </xs:attributeGroup>
   <xs:attributeGroup name="OptionalAttrs">
      <xs:attribute name="id" type="xs:ID"/>
   </xs:attributeGroup>
   <xs:simpleType name="RENumber">
      <xs:restriction base="xs:token">
         <xs:pattern value="[0-9]{1,7}"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="IFTIDRAFileName">
      <xs:restriction base="xs:token">
         <xs:pattern value="[iI][fF][tT][iI]\-[dD][rR][aA]20[0-9][0-9](0[1-9]|1[0-2])(0[1-9]|[1-2][0-9]|3[0-1])[0-9][0-9]\.[xX][mM][lL]"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="IFTIEFileName">
      <xs:restriction base="xs:token">
         <xs:pattern value="[iI][fF][tT][iI]\-[eE]20[0-9][0-9](0[1-9]|1[0-2])(0[1-9]|[1-2][0-9]|3[0-1])[0-9][0-9]\.[xX][mM][lL]"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="SMRFileName">
      <xs:restriction base="xs:token">
         <xs:pattern value="[sS][mM][rR]20[0-9][0-9](0[1-9]|1[0-2])(0[1-9]|[1-2][0-9]|3[0-1])[0-9][0-9]\.[xX][mM][lL]"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="TTRFBSFileName">
      <xs:restriction base="xs:token">
         <xs:pattern value="[tT][tT][rR]\-[fF][bB][sS]20[0-9][0-9](0[1-9]|1[0-2])(0[1-9]|[1-2][0-9]|3[0-1])[0-9][0-9]\.[xX][mM][lL]"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="TTRGSFileName">
      <xs:restriction base="xs:token">
         <xs:pattern value="[tT][tT][rR]\-[gG][sS]20[0-9][0-9](0[1-9]|1[0-2])(0[1-9]|[1-2][0-9]|3[0-1])[0-9][0-9]\.[xX][mM][lL]"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="TTRISIFileName">
      <xs:restriction base="xs:token">
         <xs:pattern value="[tT][tT][rR]\-[iI][sS][iI]20[0-9][0-9](0[1-9]|1[0-2])(0[1-9]|[1-2][0-9]|3[0-1])[0-9][0-9]\.[xX][mM][lL]"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="TTRMSBFileName">
      <xs:restriction base="xs:token">
         <xs:pattern value="[tT][tT][rR]\-[mM][sS][bB]20[0-9][0-9](0[1-9]|1[0-2])(0[1-9]|[1-2][0-9]|3[0-1])[0-9][0-9]\.[xX][mM][lL]"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="ReportCount">
      <xs:restriction base="xs:positiveInteger">
         <xs:totalDigits value="6"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="ReportType">
      <xs:restriction base="xs:token">
         <xs:enumeration value="IFTI-E"/>
         <xs:enumeration value="IFTI-DRA"/>
         <xs:enumeration value="TTR-MSB"/>
         <xs:enumeration value="TTR-GS"/>
         <xs:enumeration value="TTR-ISI"/>
         <xs:enumeration value="TTR-FBS"/>
         <xs:enumeration value="SMR"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="Name">
      <xs:restriction base="xs:string">
         <xs:maxLength value="140"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="NameType">
      <xs:restriction base="xs:token">
         <xs:enumeration value="M"/>
         <xs:enumeration value="A"/>
         <xs:enumeration value="T"/>
         <xs:enumeration value="S"/>
         <xs:enumeration value="B"/>
         <xs:enumeration value="H"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="AddrType">
      <xs:restriction base="xs:token">
         <xs:enumeration value="M"/>
         <xs:enumeration value="P"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="Addr">
      <xs:restriction base="xs:string">
         <xs:maxLength value="140"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="Suburb">
      <xs:restriction base="xs:token">
         <xs:maxLength value="35"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="State">
      <xs:restriction base="xs:token">
         <xs:maxLength value="35"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="Postcode">
      <xs:restriction base="xs:token">
         <xs:maxLength value="15"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="Country">
      <xs:restriction base="xs:token">
         <xs:maxLength value="35"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:complexType name="Address">
      <xs:sequence>
         <xs:element name="addr" type="Addr"/>
         <xs:element name="suburb" type="Suburb"/>
         <xs:element name="state" type="State" minOccurs="0"/>
         <xs:element name="postcode" type="Postcode" minOccurs="0"/>
         <xs:element name="country" type="Country"/>
      </xs:sequence>
      <xs:attributeGroup ref="RequiredAttrs"/>
   </xs:complexType>
   <xs:complexType name="AddressBasic">
      <xs:sequence>
         <xs:element name="addr" type="Addr"/>
         <xs:element name="suburb" type="Suburb" minOccurs="0"/>
         <xs:element name="state" type="State" minOccurs="0"/>
         <xs:element name="postcode" type="Postcode" minOccurs="0"/>
         <xs:element name="country" type="Country" minOccurs="0"/>
      </xs:sequence>
      <xs:attributeGroup ref="RequiredAttrs"/>
   </xs:complexType>
   <xs:complexType name="AddressAllOptional">
      <xs:sequence>
         <xs:element name="addr" type="Addr" minOccurs="0"/>
         <xs:element name="suburb" type="Suburb" minOccurs="0"/>
         <xs:element name="state" type="State" minOccurs="0"/>
         <xs:element name="postcode" type="Postcode" minOccurs="0"/>
         <xs:element name="country" type="Country" minOccurs="0"/>
      </xs:sequence>
      <xs:attributeGroup ref="RequiredAttrs"/>
   </xs:complexType>
   <xs:complexType name="AddressWithType">
      <xs:sequence>
         <xs:element name="type" type="AddrType"/>
         <xs:element name="addr" type="Addr"/>
         <xs:element name="suburb" type="Suburb" minOccurs="0"/>
         <xs:element name="state" type="State" minOccurs="0"/>
         <xs:element name="postcode" type="Postcode" minOccurs="0"/>
         <xs:element name="country" type="Country"/>
      </xs:sequence>
      <xs:attributeGroup ref="RequiredAttrs"/>
   </xs:complexType>
   <xs:complexType name="AddressNoCountry">
      <xs:sequence>
         <xs:element name="addr" type="Addr"/>
         <xs:element name="suburb" type="Suburb"/>
         <xs:element name="state" type="State"/>
         <xs:element name="postcode" type="Postcode"/>
      </xs:sequence>
      <xs:attributeGroup ref="RequiredAttrs"/>
   </xs:complexType>
   <xs:simpleType name="AcctType">
      <xs:restriction base="xs:token">
         <xs:enumeration value="BETTING"/>
         <xs:enumeration value="BULLION"/>
         <xs:enumeration value="CHEQUE"/>
         <xs:enumeration value="CREDIT"/>
         <xs:enumeration value="CUSTODY"/>
         <xs:enumeration value="ECUR"/>
         <xs:enumeration value="FCUR"/>
         <xs:enumeration value="INS"/>
         <xs:enumeration value="INVEST"/>
         <xs:enumeration value="HIRE"/>
         <xs:enumeration value="LOAN"/>
         <xs:enumeration value="OTHER"/>
         <xs:enumeration value="PENSION"/>
         <xs:enumeration value="REMIT"/>
         <xs:enumeration value="RETIRE"/>
         <xs:enumeration value="VALCARD"/>
         <xs:enumeration value="SUPER"/>
         <xs:enumeration value="TRADE"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="AcctOtherDesc">
      <xs:restriction base="xs:token">
         <xs:maxLength value="20"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="AcctTitle">
      <xs:restriction base="xs:string">
         <xs:maxLength value="140"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="AcctBSB">
      <xs:restriction base="xs:token">
         <xs:pattern value="[0-9]{6}"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="AcctNumber">
      <xs:restriction base="xs:token">
         <xs:maxLength value="34"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:complexType name="AccountOptBSB">
      <xs:sequence>
         <xs:element name="title" type="AcctTitle"/>
         <xs:element name="bsb" type="AcctBSB" minOccurs="0"/>
         <xs:element name="number" type="AcctNumber"/>
      </xs:sequence>
      <xs:attributeGroup ref="RequiredAttrs"/>
   </xs:complexType>
